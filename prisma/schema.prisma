generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Facility {
  id           String         @id @default(cuid())
  ownerId      String
  name         String
  description  String?
  address      String         @default("")
  city         String         @default("")
  latitude     Float?
  longitude    Float?
  photos       String[]       @default([])
  openHour     Int            @default(6)
  closeHour    Int            @default(22)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  courts       Court[]
  groups       BookingGroup[]
  owner        User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([isActive])
  @@index([latitude, longitude])
}

model Court {
  id         String    @id @default(cuid())
  facilityId String
  name       String
  type       CourtType @default(OUTDOOR)
  hourlyRate Decimal   @db.Decimal(10, 2)
  openHour   Int       @default(6)
  closeHour  Int       @default(22)
  isActive   Boolean   @default(true)
  latitude   Float?
  longitude  Float?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  bookings   Booking[]
  facility   Facility  @relation(fields: [facilityId], references: [id], onDelete: Cascade)

  @@unique([facilityId, name])
  @@index([facilityId])
  @@index([isActive])
  @@index([latitude, longitude])
}

/// Groups multiple Booking records into a single checkout transaction.
/// A player selecting 3 hours across 2 courts creates 1 BookingGroup + 3 Bookings.
model BookingGroup {
  id              String           @id @default(cuid())
  playerId        String
  facilityId      String?
  totalPrice      Decimal          @db.Decimal(10, 2)
  status          BookingStatus    @default(PENDING_PAYMENT)
  /// A PENDING_PAYMENT group holds its slots only until this instant.
  expiresAt       DateTime
  notes           String?
  paymentMethodId String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  bookings        Booking[]
  facility        Facility?        @relation(fields: [facilityId], references: [id])
  paymentMethod   PaymentMethod?   @relation(fields: [paymentMethodId], references: [id])
  player          User             @relation(fields: [playerId], references: [id], onDelete: Cascade)
  receipt         PaymentReceipt?
  xenditPayments  XenditPayment[]

  @@index([playerId, createdAt])
  @@index([playerId, status])
  @@index([facilityId, status])
  @@index([status])
  @@index([expiresAt])
  @@index([paymentMethodId])
}

model Booking {
  id        String         @id @default(cuid())
  groupId   String?
  playerId  String
  courtId   String
  /// Calendar day of the slot, used for the day-grid lookup.
  date      DateTime       @db.Date
  /// Exact slot boundaries. startTime is the slot key enforced by the partial
  /// unique index `booking_active_slot_unique`.
  startTime DateTime
  endTime   DateTime
  /// Price for this individual slot (court's hourlyRate at time of booking).
  totalPrice Decimal       @db.Decimal(10, 2)
  status     BookingStatus @default(PENDING_PAYMENT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  player  User           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  court   Court          @relation(fields: [courtId], references: [id], onDelete: Cascade)
  group   BookingGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([courtId, date])
  @@index([date, status])
  @@index([playerId, createdAt])
  @@index([status])
  @@index([groupId])
}

model PaymentReceipt {
  id              String        @id @default(cuid())
  groupId         String        @unique
  /// Public URL produced by the active storage driver (see src/lib/storage).
  screenshotUrl   String
  referenceNumber String?
  amountClaimed   Decimal?      @db.Decimal(10, 2)
  uploadedAt      DateTime      @default(now())
  verifiedAt      DateTime?
  verifiedById    String?
  rejectionReason String?
  group           BookingGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  verifiedBy      User?         @relation("ReceiptVerifier", fields: [verifiedById], references: [id])

  @@index([verifiedById])
}

model PaymentMethod {
  id            String         @id @default(cuid())
  /// Display name: "GCash", "Maya", "BPI", etc.
  name          String
  accountName   String
  accountNumber String?
  /// Public URL produced by the active storage driver (see src/lib/storage).
  qrCodeUrl     String?
  instructions  String
  isActive      Boolean        @default(true)
  sortOrder     Int            @default(0)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  ownerId       String
  groups        BookingGroup[]
  owner         User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
}

model User {
  id             String           @id @default(cuid())
  email          String           @unique
  passwordHash   String
  name           String
  phone          String?
  role           Role             @default(PLAYER)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  isActive       Boolean        @default(true)
  /// XenPlatform sub-account Business ID for this owner. When set, Xendit
  /// Payment Sessions for their facilities are created with the `for-user-id`
  /// header so funds settle into the owner's own Xendit balance instead of
  /// the platform master account. Null = settle to master (manual payouts).
  xenditSubAccountId String?    @unique
  booking        Booking[]
  bookingGroup   BookingGroup[]
  facilities     Facility[]
  paymentMethods PaymentMethod[]
  verifiedReceipts PaymentReceipt[] @relation("ReceiptVerifier")

  @@index([isActive])
  @@index([role])
}

enum Role {
  SUPER_ADMIN
  OWNER
  PLAYER
}

enum CourtType {
  INDOOR
  OUTDOOR
}

enum BookingStatus {
  PENDING_PAYMENT
  PENDING_VERIFICATION
  CONFIRMED
  REJECTED
}

/// Internal status of a single Xendit Payment Session attempt.
///
/// A BookingGroup keeps its existing BookingStatus lifecycle; a PAID Xendit
/// payment flips the group (and its bookings) to CONFIRMED, while any other
/// terminal Xendit outcome leaves the group in PENDING_PAYMENT so the player
/// can retry until the hold in `expiresAt` is swept.
enum XenditPaymentStatus {
  PENDING
  PAID
  FAILED
  EXPIRED
  CANCELLED
}

/// One row per Xendit Payment Session created for a BookingGroup.
///
/// A group may have several rows (one per retry); only one PENDING row is
/// ever active at a time. The webhook handler is the sole writer of terminal
/// statuses — never the browser return URL.
model XenditPayment {
  id               String              @id @default(cuid())
  groupId          String
  /// Our unique merchant reference sent as Xendit's `reference_id`.
  referenceId      String              @unique
  /// Xendit's `payment_session_id` (e.g. `ps-...`), known after creation.
  paymentSessionId String?             @unique
  /// Hosted checkout URL returned at creation; reused while the row is PENDING.
  checkoutUrl      String?
  /// True when the session was created `for-user-id`, i.e. funds settle into
  /// the facility owner's sub-account rather than the platform master.
  settledToOwner   Boolean           @default(false)
  /// Xendit's `payment_id`, populated when the session completes.
  paymentId        String?
  /// Xendit's `payment_request_id`, populated when the session completes.
  paymentRequestId String?
  amount           Decimal             @db.Decimal(10, 2)
  currency         String              @default("PHP")
  status           XenditPaymentStatus @default(PENDING)
  /// Channel the customer actually paid with (e.g. `GCASH`, `CARDS`).
  paymentChannel   String?
  failureCode      String?
  expiresAt        DateTime?
  paidAt           DateTime?
  /// Last processed webhook/event identifier for this payment (audit trail).
  lastWebhookId    String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  group            BookingGroup        @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, status])
  @@index([groupId, createdAt])
  @@index([status])
}

/// Raw Xendit webhook deliveries, keyed by event id for idempotency.
///
/// Every delivery is recorded before processing so a duplicate delivery of
/// the same event is acknowledged without touching payment state twice.
/// Serverless-safe: idempotency lives in the database, not in memory.
model XenditWebhookEvent {
  id               String   @id @default(cuid())
  /// Xendit's webhook/event identifier (`id` field of the payload).
  eventId          String   @unique
  event            String
  paymentSessionId String?
  referenceId      String?
  payload          Json
  receivedAt       DateTime @default(now())

  @@index([paymentSessionId])
  @@index([referenceId])
}
