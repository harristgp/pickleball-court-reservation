# ---------------------------------------------------------------------------
# Database
#
# DATABASE_URL should use connection pooling (port 5432 for Prisma Postgres).
# DATABASE_DIRECT_URL bypasses the pooler for migrations (required by Prisma).
# For Prisma Postgres: use the pooled URL for DATABASE_URL and the direct
# URL for DATABASE_DIRECT_URL (same host, no pgbouncer).
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://user:pass@pooled.db.prisma.io:5432/postgres?sslmode=require"
DATABASE_DIRECT_URL="postgresql://user:pass@direct.db.prisma.io:5432/postgres?sslmode=require"

# ---------------------------------------------------------------------------
# Auth (NextAuth v5). Generate a secret with: openssl rand -base64 32
# ---------------------------------------------------------------------------
AUTH_SECRET="replace-me-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# File storage. One of: local | uploadthing | supabase
#
# Whichever driver is active, it returns a public URL string that is stored
# verbatim in PaymentConfiguration.qrCodeUrl and PaymentReceipt.screenshotUrl.
# Swapping drivers requires no schema change and no data migration for new
# uploads (existing rows keep pointing at whatever produced them).
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"

# --- local driver ----------------------------------------------------------
# Writes to ./public/uploads/<folder>/<uuid>.<ext> and returns /uploads/...
# No configuration required. Not suitable for serverless/multi-instance deploys.

# --- uploadthing driver ----------------------------------------------------
# 1. Create an app at https://uploadthing.com/dashboard
# 2. Copy the app token below
# 3. npm i uploadthing
# UPLOADTHING_TOKEN=""

# --- supabase driver -------------------------------------------------------
# 1. Create a project at https://supabase.com
# 2. Storage -> New bucket -> name it "pickleball" -> mark it Public
# 3. Settings -> API -> copy the URL and the service_role key (server-only!)
# 4. npm i @supabase/supabase-js
# SUPABASE_URL=""
# SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_BUCKET="pickleball"

# ---------------------------------------------------------------------------
# Xendit online payments (server-only — never use a NEXT_PUBLIC_ prefix).
# 1. Create an account at https://dashboard.xendit.co
# 2. Developers -> API keys -> copy the secret key below
# 3. Settings -> Developers -> Webhooks -> copy the verification token below
#    and register the callback URL:
#    https://<your-app>/api/payments/xendit/webhook
# Without both keys, checkout falls back to the manual QR + receipt flow.
# ---------------------------------------------------------------------------
# XENDIT_SECRET_KEY="xnd_development_..."
# XENDIT_WEBHOOK_TOKEN=""

# ---------------------------------------------------------------------------
# XenPlatform direct-to-owner payouts (optional).
# Without this, player payments settle to your master Xendit balance and you
# pay owners out manually. With it, each owner's payments settle into their
# own sub-account balance, withdrawable to their bank from the Xendit dashboard:
# 1. Ask Xendit to activate xenPlatform on your master account.
# 2. Invite each court owner as a sub-account (they complete KYC and link
#    their bank inside the Xendit dashboard).
# 3. Each owner pastes their sub-account Business ID at /owner/settings
#    ("Online payouts"). One sub-account per owner; duplicates are rejected.
# 4. (Optional) Create a split rule for your platform commission and set it
#    below — it is applied per transaction via the with-split-rule header.
#    Leave some remainder for transaction fees; a 100% split will fail.
# ---------------------------------------------------------------------------
# XENDIT_SPLIT_RULE_ID="splitru_..."
