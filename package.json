{
  "name": "pcourt",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts",
    "check:double-book": "tsx scripts/check-double-book.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "leaflet": "1.9.4",
    "lucide-react": "0.454.0",
    "next": "^16.3.3",
    "next-auth": "^5.0.0-beta.32",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-leaflet": "4.2.1",
    "tailwind-merge": "2.5.4",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/leaflet": "1.9.14",
    "@types/node": "20.17.6",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "1.5.5",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "10.9.1",
    "eslint-config-next": "16.3.3",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "postcss": "8.5.26",
    "prisma": "^5.22.0",
    "qrcode": "1.5.4",
    "tailwindcss": "3.4.14",
    "tsx": "^4.19.2",
    "typescript": "5.6.3"
  },
  "overrides": {
    "eslint-config-next": {
      "eslint-plugin-react": "github:jsx-eslint/eslint-plugin-react#b73f110",
      "eslint-plugin-jsx-a11y": "$eslint-plugin-jsx-a11y"
    }
  },
  "allowScripts": {
    "@prisma/engines@5.22.0": true,
    "@prisma/client@5.22.0": true,
    "prisma@5.22.0": true,
    "unrs-resolver@1.12.2": true,
    "esbuild@0.28.2": true
  }
